<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Bỏ sandbox y như Release (xem comment dài trong Release.entitlements).
	     Giữ sandbox riêng ở debug là bản debug đọc/ghi container còn bản
	     release đọc ~/Library/Application Support — hai đường dẫn khác nhau,
	     test migration lẫn test dữ liệu local đều sai. -->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<!-- Debug cần: VM service của Dart mở socket để hot reload / DevTools. -->
	<key>com.apple.security.network.server</key>
	<true/>
	<key>com.apple.security.network.client</key>
	<true/>
</dict>
</plist>
