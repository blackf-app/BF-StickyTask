<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Tu cai ban moi (xem ApkInstaller.kt + lib/data/update_installer.dart).
         REQUEST_INSTALL_PACKAGES: bat buoc de goi PackageInstaller. Tu API 26
         user con phai bat rieng cho app nay, native tu mo dung trang cai dat.
         UPDATE_PACKAGES_WITHOUT_USER_ACTION (API 31+, quyen normal, khong hoi
         user): cho phep tu cap nhat CHINH MINH ma khong hien dialog, voi dieu
         kien ban dang chay do chinh app nay cai. Khong du dieu kien thi he
         thong lang le hien dialog nhu thuong, khong loi. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
    <uses-permission android:name="android.permission.UPDATE_PACKAGES_WITHOUT_USER_ACTION"/>

    <application
        android:label="BF-StickyTask"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Ket qua cai dat tu PackageInstaller. exported=false: chi he thong
             gui broadcast tra ve dung PendingIntent cua chinh app nay.
             Nam trong manifest chu khong registerReceiver() trong code, vi
             STATUS_SUCCESS ve SAU khi app da bi kill de thay APK — he thong
             phai cold-start duoc receiver nay de mo lai app. -->
        <receiver
            android:name=".InstallResultReceiver"
            android:enabled="true"
            android:exported="false"/>

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Android 11+ (package visibility): thiếu khối này thì url_launcher
             không thấy browser nào → nút "Tải bản mới" trong popup cập nhật
             không mở được trang release. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
    </queries>
</manifest>
